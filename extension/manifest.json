{
  "manifest_version": 3,
  "name": "SocialEdge",
  "version": "2.1.11",
  "description": "Track and improve your LinkedIn Social Selling Score with user-controlled refreshes.",

  "permissions": [
    "webRequest",
    "storage",
    "alarms",
    "scripting",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SocialEdge — Your Selling Score"
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
